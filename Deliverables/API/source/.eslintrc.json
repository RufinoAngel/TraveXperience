{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    /* -----------------------------------------------------------------
     * Ajustes deliberados sobre Airbnb Base, documentados uno por uno.
     * La meta es NO desactivar reglas "porque molestan", sino solo las
     * que chocan con decisiones reales de arquitectura del proyecto.
     * sourceType se deja en "module" (default de Airbnb): así ESLint
     * asume strict mode automáticamente y no exige el pragma
     * 'use strict' en cada archivo CommonJS.
     * ----------------------------------------------------------------- */

    // require() dinámico dentro de funciones (ej. carga condicional
    // de modelos) es un patrón válido en Node, no un code smell aquí.
    "global-require": "off",

    // Mongoose expone _id, __v, etc. Prohibir "_" rompería el tipado
    // natural de los documentos que vienen de MongoDB.
    "no-underscore-dangle": ["error", { "allow": ["_id", "__v"] }],

    // El logger centralizado (utils/logger.js) es la ÚNICA fuente
    // permitida de console.*; en el resto del código está prohibido
    // para forzar el uso del logger (ver "overrides" más abajo).
    "no-console": "error",

    // Reasignar propiedades de req/res (ej. req.user = decoded en
    // middlewares de auth) es un patrón estándar de Express.
    "no-param-reassign": ["error", { "props": false }],

    // Líneas más largas son razonables con comentarios en español y JSDoc.
    "max-len": ["error", { "code": 110, "ignoreUrls": true, "ignoreComments": false }],

    // Los controladores exportan varias funciones nombradas (no un
    // default export), patrón intencional en todo el proyecto.
    "import/prefer-default-export": "off",

    // Clases utilitarias simples (ApiResponse, AppError) no necesitan
    // forzar que todos sus métodos sean estáticos.
    "class-methods-use-static": "off"
  },
  "overrides": [
    {
      "files": ["src/utils/logger.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
